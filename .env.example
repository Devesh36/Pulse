# Run: uv run python scripts/setup-env.py  (creates unique secrets in .env)
PULSE_ADMIN_TOKEN=
PULSE_ADAPTER_TOKEN=
POSTGRES_PASSWORD=
PULSE_DEMO_TOKEN=
PULSE_DATABASE_URL=postgresql+psycopg://pulse:replace-with-POSTGRES_PASSWORD@localhost:5432/pulse
PULSE_ADAPTER_URL=http://127.0.0.1:8001
PULSE_PROMETHEUS_URL=http://127.0.0.1:9090
PULSE_WEB_ORIGIN=http://localhost:3000
# Empty model = honest, deterministic evidence mode; no cloud account needed.
PULSE_LLM_MODEL=
PULSE_LLM_API_KEY=
PULSE_LLM_API_BASE=
# Examples: openai/gpt-4.1-mini, anthropic/claude-sonnet-4-5,
#           openai/local-model (with API_BASE=http://host.docker.internal:11434/v1)
PULSE_PROBE_URLS={"faulty-app":"http://faulty-app:8080/health"}
PULSE_PROBE_ALLOWED_HOSTS=["faulty-app","localhost","127.0.0.1"]
# Optional gateway-level kill switch; API also has a runtime emergency switch.
PULSE_GATEWAY_DISABLED=false
